digraph STKCatalog {
  rankdir=LR;
  graph [fontname="Arial", labelloc="t", label="STK Motors runtime call graph"];
  node [shape=box, style="rounded", fontname="Arial"];
  edge [fontname="Arial"];
  browser [label="Public browser"];
  home [label="Home catalog /"];
  detail [label="Product detail /product/:slug"];
  products [label="GET /api/products"];
  product [label="GET /api/products/:slug"];
  stats [label="GET /api/stats"];
  settings [label="GET /api/settings"];
  db [label="Prisma + SQLite", shape=cylinder];
  adminBrowser [label="Admin browser"];
  login [label="/panel login"];
  authApi [label="POST/DELETE /api/auth"];
  rateLimit [label="Login rate limiter"];
  protected [label="Server protected panel layout"];
  sessionApi [label="GET /api/auth/session"];
  adminPages [label="Panel pages"];
  adminApi [label="/api/admin/*"];
  auth [label="JWT cookie + requireAdmin"];
  futureForm [label="Future catalog inquiry", style="rounded,dashed"];
  futureApi [label="Future /api/inquiries", style="rounded,dashed"];
  crm [label="CrmClient boundary", style="rounded,dashed"];
  didar [label="Didar CRM", style="rounded,dashed"];
  browser -> home;
  home -> products;
  home -> stats;
  home -> settings;
  browser -> detail;
  detail -> product;
  detail -> settings;
  products -> db;
  product -> db;
  stats -> db;
  settings -> db;
  adminBrowser -> login;
  login -> authApi;
  authApi -> rateLimit;
  authApi -> db;
  authApi -> auth;
  adminBrowser -> protected;
  protected -> auth;
  adminPages -> sessionApi;
  sessionApi -> auth;
  adminPages -> adminApi;
  adminApi -> auth;
  adminApi -> db;
  futureForm -> futureApi [style=dashed, label="later"];
  futureApi -> crm [style=dashed, label="later"];
  crm -> didar [style=dashed, label="later"];
}
